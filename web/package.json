{
  "name": "nl-streaming-web-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/preprocess.ts && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "check:i18n": "tsx scripts/check-i18n-keys.ts",
    "test:search": "tsx scripts/test-search.ts",
    "test:filters": "tsx scripts/test-filters.ts",
    "verify-wiring": "tsx scripts/verify-wiring.ts"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@tanstack/react-router": "^1.29.0",
    "@tanstack/react-virtual": "^3.2.0",
    "minisearch": "^7.1.0",
    "zustand": "^4.5.0",
    "clsx": "^2.1.0",
    "react-hotkeys-hook": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@tanstack/router-vite-plugin": "^1.29.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tsx": "^4.7.0",
    "papaparse": "^5.4.0",
    "@types/papaparse": "^5.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "prettier": "^3.2.0"
  }
}
